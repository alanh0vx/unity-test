# ---- Unity generated folders (any location, e.g. vxrl-fps/Library) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity3D generated meta files for files that are themselves ignored
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Keep .meta files for assets (only ignore meta when the asset itself is ignored)
!/[Aa]ssets/**/*.meta

# ---- IDE / tooling ----
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
*.pidb
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ---- Unity builds / packages / crash files ----
sysinfo.txt
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# ---- Project scratch / working files (not for the repo) ----
/tmp/
